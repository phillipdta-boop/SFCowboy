# The `anon` key is public by design (safe to ship in a browser bundle) — this is different from the server's `service_role` key (Task 1), which must never appear here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Baked into the bundle at build time and used as the "Forgot password?" reset link's redirect --
# mirrors server/.env.example's APP_BASE_URL. Defaults to https://deploy.effluence.com.au in code
# when unset, so this only needs setting to override that (e.g. to http://localhost:3000 for local
# dev, so a reset link you send yourself while testing locally actually lands back on localhost).
VITE_APP_BASE_URL=
