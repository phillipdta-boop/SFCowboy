# Copy to .env (repo root) on the VM before running `docker compose up -d --build`.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Required: connection string for the Postgres database this server reads/writes. Must be a real
# Supabase project's Session pooler connection string (Project Settings -> Database -> Connection
# string -> "Session", host pattern aws-0-<region>.pooler.supabase.com:5432) or its Direct
# connection string -- NOT the Transaction pooler (typically port 6543). See server/.env.example
# for the full explanation of why Transaction-mode pooling doesn't work here.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase project URL and service_role key (Project Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is a secret with full admin access to this project's Auth and
# database (bypasses Row Level Security entirely) -- never expose it to the browser, never log it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Same Supabase project's URL and public anon key, baked into the web bundle at build time (see
# the app service's build.args in docker-compose.yml and Dockerfile's web-build stage). The anon
# key is public by design (safe to ship in a browser bundle) -- do not put the service_role key
# here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Only needed if the VM isn't serving deploy.effluence.com.au (e.g. testing under a different
# domain/IP) -- otherwise the default in docker-compose.yml is correct. This is also what invite
# and password-reset emails use to link back into the app, so it must match wherever this
# container is actually reachable.
# APP_BASE_URL=https://deploy.effluence.com.au

# Only needed if the VM isn't serving deploy.effluence.com.au -- otherwise the default in
# docker-compose.yml is correct.
# OAUTH_CALLBACK_URL=https://deploy.effluence.com.au/oauth/callback

# Only needed on first boot against a database with no admin user yet -- bootstraps one admin
# app_users row so there's a way to log in and invite everyone else. Safe to remove from .env
# after the first successful boot.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
