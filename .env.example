# Copy to .env (repo root) on the VM before running `docker compose up -d`.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Only needed if the VM isn't serving deploy.effluence.com.au (e.g. testing under a
# different domain/IP) — otherwise the default in docker-compose.yml is correct.
# OAUTH_CALLBACK_URL=https://deploy.effluence.com.au/oauth/callback

# Required only the very first time `docker compose up` runs against a fresh (empty) database —
# creates the first organization and admin account, then is never needed again. Leave unset on
# every later deploy; an already-bootstrapped deployment ignores these. To add further
# organizations afterwards, see "One-time production setup" in README.md.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional, only used on that same first boot. Defaults to "My Organization".
# BOOTSTRAP_ORG_NAME=
