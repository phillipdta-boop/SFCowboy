# Copy this file to .env and fill in the values below.
# Nothing here needs a Salesforce Connected App — connecting an org is done
# from the app itself (Connections page) with a normal Salesforce login.

# Required: 32-byte hex string used to encrypt stored tokens at rest.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# Optional (defaults shown)
PORT=3000
DB_PATH=./sfcowboy.db
DATA_DIR=./data

# Salesforce requires a callback URL on every Connected App, even though this app's
# org-connect flow never redirects a browser to it. Any well-formed URL works.
OAUTH_CALLBACK_URL=http://localhost:3000/oauth/callback
