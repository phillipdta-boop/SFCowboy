# Copy this file to .env and fill in the values below.
# Connecting an org needs no manual Connected App setup on your part — see
# "Connecting an org" in the README. This file only configures the server.

# Required: 32-byte hex string used to encrypt stored tokens at rest.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# Required: connection string for the Postgres database this server reads/writes.
DATABASE_URL=postgres://sfcowboy@localhost:5433/sfcowboy

# Supabase project URL and keys (Project Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is a secret with full admin access to this project's Auth and
# database (bypasses Row Level Security entirely) -- never expose it to the browser, never log it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# DATABASE_URL must use Supabase's Session pooler connection string (Project Settings -> Database
# -> Connection string -> "Session", host pattern aws-0-<region>.pooler.supabase.com:5432) or the
# project's Direct connection string -- NOT the Transaction pooler (typically port 6543). This
# codebase relies on session-level state (search_path in tests, and node-postgres's default
# prepared statements) that Transaction-mode pooling does not preserve across queries.

# Required only on first boot against a database with no admin user yet.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional (default shown) -- name of the one organization every pre-Plan-2 row belongs to.
BOOTSTRAP_ORG_NAME=My Organization

# Optional (defaults shown)
PORT=3000
DATA_DIR=./data

# Must match the callback URL configured on the SFCowboy Connected App, and must be reachable by
# the browser during the OAuth redirect (this is where Salesforce sends the user back to after
# login). Change this if you're running somewhere other than localhost:3000.
OAUTH_CALLBACK_URL=http://localhost:3000/oauth/callback

# Optional — only set this if the SFCowboy Connected App is ever recreated under a new Consumer
# Key. Defaults to the current one (see server/src/config.ts). This is a public client ID, not a
# secret, and works to authorize any org — it doesn't need to exist inside that org already.
# SF_CLIENT_ID=
