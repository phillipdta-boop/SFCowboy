# Copy this file to .env and fill in the values below.
# Connecting an org needs no manual Connected App setup on your part — see
# "Connecting an org" in the README. This file only configures the server.

# Required: 32-byte hex string used to encrypt stored tokens at rest.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# Optional (defaults shown)
PORT=3000
DB_PATH=./sfcowboy.db
DATA_DIR=./data

# Must match the callback URL configured on the packaged SFCowboy Connected App, and must be
# reachable by the browser during the OAuth redirect (this is where Salesforce sends the user
# back to after login). Change this if you're running somewhere other than localhost:3000.
OAUTH_CALLBACK_URL=http://localhost:3000/oauth/callback

# Optional — only set these if the SFCowboy package is ever rebuilt/republished under a new
# version. Both default to the current packaged Connected App (see server/src/config.ts).
# SF_PACKAGE_CLIENT_ID=
# SF_PACKAGE_INSTALL_URL=
